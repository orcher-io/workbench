{
  "name": "@orcher/workbench-window-manager",
  "version": "0.1.1",
  "description": "Window, tab, and split management for the workbench",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/orcher-io/workbench.git"
  },
  "keywords": [
    "window",
    "tabs",
    "split",
    "layout",
    "workbench"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@orcher/workbench-di": "workspace:^",
    "@orcher/workbench-plugin-api": "workspace:^",
    "@orcher/workbench-ui": "workspace:^",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.1.6",
    "framer-motion": "^11.15.0",
    "zustand": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nx build @orcher/workbench-window-manager"
  }
}
