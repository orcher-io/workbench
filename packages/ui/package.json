{
  "name": "@orcher/workbench-ui",
  "version": "0.1.0",
  "description": "UI components built on Radix Themes for the workbench",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/orcher-io/workbench.git"
  },
  "keywords": [
    "ui",
    "components",
    "radix",
    "themes",
    "workbench"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.1.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@orcher/workbench-plugin-api": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nx build @orcher/workbench-ui"
  }
}
