{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@orcher/workbench-di": ["packages/di/src/index.ts"],
      "@orcher/workbench-plugin-api": ["packages/plugin-api/src/index.ts"],
      "@orcher/workbench-services": ["packages/services/src/index.ts"],
      "@orcher/workbench-ui": ["packages/ui/src/index.ts"],
      "@orcher/workbench-window-manager": ["packages/window-manager/src/index.ts"],
      "@orcher/workbench-core": ["packages/core/src/index.ts"],
      "@orcher/workbench-plugin-welcome": ["plugins/builtin/welcome/src/index.ts"],
      "@orcher/workbench-plugin-settings": ["plugins/builtin/settings/src/index.ts"],
      "@orcher/workbench-plugin-search": ["plugins/builtin/search/src/index.ts"],
      "@orcher/workbench-plugin-sample": ["plugins/builtin/sample/src/index.ts"],
      "@orcher/workbench-plugin-header": ["plugins/builtin/header/src/index.ts"],
      "@orcher/workbench-plugin-breadcrumb-bar": [
        "plugins/builtin/breadcrumb-bar/src/index.ts",
      ],
      "@orcher/workbench-plugin-explorer": ["plugins/builtin/explorer/src/index.ts"],
      "@orcher/workbench-plugin-bookmarks": [
        "plugins/builtin/bookmarks/src/index.ts",
      ],
    },
  },
}
