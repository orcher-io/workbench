{
  "name": "@orcher/workbench-plugin-explorer",
  "version": "0.1.0",
  "description": "Explorer plugin with simple registration API and URL routing",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@orcher/workbench-plugin-api": "workspace:^",
    "@orcher/workbench-services": "workspace:^",
    "@orcher/workbench-ui": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/orcher-io/workbench.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nx build @orcher/workbench-plugin-explorer"
  }
}
